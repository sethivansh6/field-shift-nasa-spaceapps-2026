# Python environment and caches (large, rebuilt with: pip install -r requirements.txt)
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Credentials and local settings (never commit)
.env
*.env
.streamlit/secrets.toml
*credentials*
*.pem
*.key

# Raw downloads (re-created by the src/extract_*.py scripts)
data/raw/*
